# Phase 0 voice-loop spike: API keys.
# Copy this file to spikes/voice-loop/.env.local (gitignored), fill in each value,
# then run: npm --prefix spikes/voice-loop run check-keys
# Never commit real keys. Values in .env.local override the same names in your shell.

# Anthropic: Claude Haiku 5.5 interpreter (claude-haiku-5-5).
# Create at https://platform.claude.com/settings/keys (Claude Console > API keys > Create key).
ANTHROPIC_API_KEY=

# OpenAI: gpt-live-transcribe (speech-to-text), gpt-6-luna (interpreter),
# gpt-realtime-2.1-mini (voice).
# Create at https://platform.openai.com/api-keys. If you restrict the key, it needs
# Models: Read (used by check-keys) plus Realtime and Responses / Chat Completions access.
OPENAI_API_KEY=

# Deepgram: Nova-3 and Flux streaming speech-to-text.
# Create in the Deepgram Console (https://console.deepgram.com): pick the project >
# Settings > API Keys > Create a New API Key. Member role is enough.
DEEPGRAM_API_KEY=

# AssemblyAI: Universal-Streaming / Universal-3.6 Pro streaming speech-to-text.
# Create in the AssemblyAI dashboard (https://www.assemblyai.com/dashboard):
# Workspace > Manage > API Keys > Create New API Key.
ASSEMBLYAI_API_KEY=

# ElevenLabs: Flash v2.5 voices.
# Create in the ElevenLabs app (https://elevenlabs.io/app): Developers > API Keys.
# Keys are restricted by default: enable Text to Speech and Voices (Read).
ELEVENLABS_API_KEY=

# Cartesia: Sonic-3.6 voices.
# Create at https://play.cartesia.ai/keys (select your organization first).
# Use a standard key (sk_car_...), not an admin key.
CARTESIA_API_KEY=
