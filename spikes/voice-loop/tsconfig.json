{
  // Type-check only. Scripts run directly with Node's built-in type stripping
  // (`node file.ts`), so only erasable TypeScript syntax is allowed.
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true
  },
  // Top-level spike scripts, plus interp/ and live/ (0.4's analyze.ts and 0.6's server
  // aren't imported by a top-level script). recorder/ and live/'s browser code are plain JS
  // and test-set/ is data, so they're not type-checked here.
  "include": ["*.ts", "interp/**/*.ts", "live/**/*.ts"]
}
